# SpotShare Backend Email Configuration (Gmail SMTP)
# Copy this file to backend/.env and fill in your Gmail address + 16-char Google App Password.
# Generate an App Password at: https://myaccount.google.com/apppasswords (requires 2-Step Verification).

SPOTSHARE_SMTP_HOST=smtp.gmail.com
SPOTSHARE_SMTP_PORT=587
SPOTSHARE_SMTP_USER=yourgmail@gmail.com
SPOTSHARE_SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SPOTSHARE_SMTP_FROM=SpotShare <yourgmail@gmail.com>

